<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- 复用服务器的 Redis 客户端 (版本与 ArpgServer 一致) -->
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <!-- Newtonsoft (Arch数据模型) -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- 服务器WebAPI主程序: SessionManager/ShardManager (阶段04) + Unity编译的Arch程序集: RpcRateLimiter/ServerAuthority (阶段05) -->
    <Reference Include="ArpgServer">
      <HintPath>..\publish\ArpgServer.dll</HintPath>
    </Reference>
    <Reference Include="Arch">
      <HintPath>..\Library\ScriptAssemblies\Arch.dll</HintPath>
    </Reference>
    <!-- UnityEngine (Arch程序集依赖) -->
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>D:\unity\2022.3.62t8\Editor\Data\Managed\UnityEngine\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
