# Copy this file to deploy/.env on the deployment host. Do not commit deploy/.env.
BUILD_VERSION=0.1.0
SERVER_NODE_ID=cn-bj-01-node-01
LINE_ID=1
LINE_CAPACITY=50
REDIS_PASSWORD=replace-with-a-long-random-password

# Use private-network endpoints in production.
MYSQL_CONNECTION_STRING=Server=mysql.internal;Port=3306;Database=arpg;Uid=arpg;Pwd=replace-me;Charset=utf8mb4;SslMode=Required;
REDIS_CONNECTION_STRING=redis:6379,password=replace-me,abortConnect=false,connectTimeout=5000,syncTimeout=2000
JWT_KEY=replace-with-a-long-random-secret

# Public ports are deliberately limited to the API and game transport.
API_PORT=5132
GAME_PORT=7777

# Node-plane shared keys (rotate for production).
NODE_KEY=replace-with-a-long-random-node-key
GM_KEY=replace-with-a-long-random-gm-key

# Node health probing (seconds).
NODE_HEARTBEAT_TIMEOUT_SECONDS=45
NODE_PROBE_INTERVAL_SECONDS=15
